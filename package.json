{
  "name": "ag-grid-aurelia-plugin",
  "version": "31.3.11",
  "description": "ag-Grid Aurelia Component, a fork of Niall Crosby <niall.crosby@gmail.com>",
  "credits": "Niall Crosby <niall.crosby@gmail.com>",
  "main": "./main.js",
  "typings": "./main.d.ts",
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && npm run compile && npm run add-headers",
    "compile": "tsc",
    "add-headers": "node scripts/add-headers.js",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vladyn/ag-grid-aurelia1.git"
  },
  "keywords": [
    "grid",
    "data",
    "table",
    "aurelia"
  ],
  "author": "Vladimir Varbanov <vlado.var@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vladynet/ag-grid-aurelia1/issues"
  },
  "homepage": "https://github.com/vladynet/ag-grid-aurelia1/issues",
  "devDependencies": {
    "@types/core-js": "^2.5.0",
    "ag-grid-community": "^31.3.4",
    "aurelia-framework": "1.x",
    "reflect-metadata": "^0.1.12",
    "rimraf": "^6.0.1",
    "systemjs": "^6.15.1",
    "typescript": "~5.6.0"
  },
  "peerDependencies": {
    "ag-grid-community": "^31.3.4",
    "aurelia-framework": "1.x"
  },
  "aurelia": {
    "build": {
      "resources": [
        "ag-grid-aurelia/lib/agGridAurelia",
        "ag-grid-aurelia/lib/agGridColumn",
        "ag-grid-aurelia/lib/agTemplate"
      ]
    }
  },
  "dependencies": {
    "ag-grid-community-v31": "npm:ag-grid-community@^31.3.4"
  }
}
